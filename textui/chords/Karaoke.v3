// Karaoke.v3
// A VT100/VT102 sketch of the RiffHound karaoke screen: three lyric lines with
// a bouncing ball, a strum row, four big chord boxes in block-art, and a
// preview of the group coming next. 80 columns, 20 rows, 16 colours.
//
//   ./Karaoke          run it
//   ./Karaoke -still   draw one frame and exit (no raw mode; for piping)
//
// The chord font is Calvin S, a 3-line FIGlet font drawn in box-drawing
// characters (patorjk.com/software/taag). Picked over the taller ANSI fonts
// because it has real lowercase -- Am and AM are different chords -- and
// because three chars fit a 15-column bar at 3 columns each.

def T: Vt100;

// ── layout, in terminal cells ────────────────────────────────────────
def LEFT     = 3;    // left margin
def DISP     = 74;   // width the whole four-bar group spans
def BOX_W    = 17;   // one chord box
def BOX_GAP  = 2;
def GLYPH_H  = FONT_H;  // rows of chord art
def BOX_PAD  = 1;       // blank rows inside the box, above the art

def ROW_PAST    = 3;
def ROW_APEX    = 4;   // lyric ball, top of its arc
def ROW_LAND    = 5;   // lyric ball, on the syllable
def ROW_CUR     = 6;
def ROW_NEXT    = 7;
def ROW_HEAD    = 9;   // chord playhead
def ROW_STRUM   = 10;
def ROW_BOX     = 11;  // top border; glyphs at +1..+4, bottom border at +5
def ROW_PREVIEW = 18;
def ROW_STATUS  = 20;

def SLOTS = 32;  // eighth-note slots in a four-bar group

// ── box drawing ─────────────────────────────────────────────────────
def BOX_HZ = "\xe2\x94\x80";  // ─
def BOX_VT = "\xe2\x94\x82";  // │
def BOX_TL = "\xe2\x94\x8c";  // ┌
def BOX_TR = "\xe2\x94\x90";  // ┐
def BOX_BL = "\xe2\x94\x94";  // └
def BOX_BR = "\xe2\x94\x98";  // ┘
def DBL_HZ = "\xe2\x95\x90";  // ═
def DBL_VT = "\xe2\x95\x91";  // ║
def DBL_TL = "\xe2\x95\x94";  // ╔
def DBL_TR = "\xe2\x95\x97";  // ╗
def DBL_BL = "\xe2\x95\x9a";  // ╚
def DBL_BR = "\xe2\x95\x9d";  // ╝

def MARK_HEAD = "\xe2\x96\xbc";  // ▼ chord playhead
def MARK_BALL = "\xe2\x97\x8f";  // ● lyric ball
def STROKE_D  = "\xe2\x86\x93";  // ↓
def STROKE_U  = "\xe2\x86\x91";  // ↑
def STROKE_X  = "\xe2\x9c\x95";  // ✕
def STROKE_M  = "M";

// ── chord font ──────────────────────────────────────────────────────
// Calvin S, indexed by ch - 0x20. Rows are pre-padded to FONT_W columns, so
// a row's display width is FONT_W even though the bytes are UTF-8.
def FONT_BASE = 0x20;
def FONT_H = 3;
